msgid "Type a tag and press Enter"
msgstr "Pište hashtagy a stiskněte Enter nebo čárku"

#: app/templates/new_project_custom.html:146
msgid "Press Enter or comma after each tag. Click × on a tag to remove it."
msgstr ""
"Pište hashtagy a stiskněte Enter nebo čárku pro jejich přidání. Kliknutím"
" na × u tagu jej odeberete."


msgstr ""
"URL buufata kaartaa bu’uuraa ammallee hin jiru. Mee haala haaromsiitii "
"yeroo gabaabaa booda irra deebi’i."

#: app/htmx/basemap/basemap_attach_flow.py:173
#, python-format
msgid ""
"QField basemap attach is not configured on this deployment. Missing "
"%(config)s."
msgstr ""
"Maxxansi kaartaa buʼuuraa QField irratti qindaaʼinni hin taasifamne. "
"%(config)s dhabameera."


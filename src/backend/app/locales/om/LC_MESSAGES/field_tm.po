#: app/htmx/setup_steps/setup_step_extract_handlers.py:46
msgid ""
"Tasks were planned with the old data. They are kept, but reopen the task "
"planner to update feature counts."
msgstr ""
"Hojiiwwan deetaa duriitiin karoorfamaniiru. Ni eegamu, garuu lakkoofsa "
"wantootaa haaromsuuf karoorsaa hojii irra deebi'ii bani."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:79
#, python-format
msgid "OSM data downloaded successfully! Found %(feature_count)s features."
msgstr "Data OSM milkaa'inaan buufame! Amaloonni %(feature_count)s argamaniiru."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:82
msgid ""
"If this looks right, click \"Accept Data Extract\". Otherwise, try "
"downloading again with different parameters."
msgstr ""
"Yoo sirrii fakkaate, \"Baafata dataa fudhadhu\" cuqaasi. Yoo kana hin "
"taane, ulaagaalee biroon irra deebi'ii buusi."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:115
#: app/templates/partials/project_details/style_and_scripts.html:24
msgid "Invalid file type. Please upload a .geojson or .json file."
msgstr "Gosti faayilii sirrii miti. Maaloo faayilii .geojson ykn .json olkaa'i."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:138
msgid "No valid geometries found in GeoJSON."
msgstr "GeoJSON keessatti geometry sirrii hin argamne."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:152
#, python-format
msgid "✓ GeoJSON uploaded successfully! Found %(feature_count)s features."
msgstr "✓ GeoJSON milkaa'inaan olkaa'ame! Amaloonni %(feature_count)s argamaniiru."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:155
msgid ""
"If this looks right, click \"Accept Data Extract\". Otherwise, try "
"uploading a different file."
msgstr ""
"Yoo sirrii fakkaate, \"Baafata dataa fudhadhu\" cuqaasi. Yoo kana hin "
"taane, faayilii biraa olkaasi."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:188
msgid "✓ Collect-new-data mode selected. You can continue."
msgstr "✓ Haalli deetaa haaraa sassaabuu filatameera. Itti fufuu dandeessa."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:222
msgid ""
"No GeoJSON data found. Please download OSM data or upload a GeoJSON file "
"first."
msgstr ""
"Data GeoJSON hin argamne. Maaloo dura data OSM buufadhaa ykn faayilii "
"GeoJSON olkaa'aa."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:241
msgid "✓ Data extract successfully saved! You can now continue to the Tasks step."
msgstr ""
"✓ Baafanni deetaa kuufameera! Amma gara tarkaanfii Hojiiwwaniitti darbuu "
"dandeessa."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:288
msgid ""
"No data extract is staged. Please download OSM data or upload a GeoJSON "
"file first."
msgstr ""
"Baafanni deetaa qophaa'e hin jiru. Jalqaba deetaa OSM buusi ykn faayilii "
"GeoJSON olkaasi."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:303
#, python-format
msgid ""
"✓ Data extract accepted! Saved %(feature_count)s features. Step 3 is now "
"complete."
msgstr ""
"✓ Baafanni deetaa fudhatameera! Amaloota %(feature_count)s olkaa'ameera. "
"Tarkaanfiin 3 amma xumurameera."

#: app/htmx/setup_steps/setup_step_extract_handlers.py:343
msgid "Data extract discarded. Choose a data source above to try again."
msgstr ""
"Baafanni deetaa gatameera. Irra deebi'ii yaaluuf madda deetaa olii "
"filadhu."

#: app/htmx/setup_steps/setup_step_extract_helpers.py:42
msgid "Invalid GeoJSON data in request. Please try uploading again."
msgstr "Gaaffii keessatti data GeoJSON sirrii miti. Maaloo irra deebi'ii olkaa'i."

#: app/htmx/setup_steps/setup_step_extract_helpers.py:50
msgid "Error reading GeoJSON data from request."
msgstr "Gaaffii irraa data GeoJSON dubbisuun dogoggora uumame."

#: app/htmx/setup_steps/setup_step_finalize_routes.py:104

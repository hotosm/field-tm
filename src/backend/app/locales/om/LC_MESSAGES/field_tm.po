#: app/htmx/basemap/basemap_attach_flow.py:69
msgid ""
"Basemap attach failed for now. Your project is ready to use. Please retry"
" attach."
msgstr ""
"Kaartaa bu'uuraa maxxansuun ammaaf hin milkoofne. Pirojektiin kee itti "
"fayyadamuuf qophaa'eera. Maaloo irra deebi'i maxxansi."

#: app/htmx/basemap/basemap_attach_flow.py:74
msgid ""
"Basemap attach could not complete due to a temporary network issue. Your "
"project is ready to use. Please retry attach."
msgstr ""
"Rakkoo neetworkii yeroo gabaabaa irraa kan ka'e kaartaa bu'uuraa "
"maxxansuun xumuramuu hin dandeenye. Pirojektiin kee itti fayyadamuuf "
"qophaa'eera. Maaloo irra deebi'i maxxansi."

#: app/htmx/basemap/basemap_attach_flow.py:123
msgid "Basemap attach is available after publication."
msgstr "Maxxansi kaartaa buʼuuraa maxxansiisuu booda ni argama."

#: app/htmx/basemap/basemap_attach_flow.py:132
msgid "Basemap attach is only available for QField projects."

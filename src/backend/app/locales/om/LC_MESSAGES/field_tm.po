msgstr "Appii kaartaa GIS Android fi iOS-iif, plugin hojii salphaa keenya waliin."

#: app/projects/mapping_apps.py:49
msgid "Drawing and editing geometry, detailed surveys"
msgstr "Jiomeetirii kaasuu fi gulaaluu, qorannoo bal'aa"

#: app/projects/mapping_apps.py:57
msgid "Form-based survey app for Android."
msgstr "Appii qorannoo foormii irratti hundaa'e Android-iif."

#: app/projects/mapping_apps.py:58
msgid "Form-heavy surveys, simple phones"
msgstr "Qorannoo foormii baay'ee qabu, bilbilota salphaa"


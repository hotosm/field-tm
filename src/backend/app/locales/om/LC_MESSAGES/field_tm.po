#: app/templates/partials/project_details/fragments/task_sync_confirm.html:14
msgid ""
"The task layer of the QField project will be regenerated and\n"
"      re-uploaded to QFieldCloud. Mappers must sync or re-download the "
"project. Task progress and\n"
"      survey data already synced to QFieldCloud are kept."
msgstr ""
"Sadarkaan hojii pirojektii QField irra deebi'ee uumamee QFieldCloud-tti "
"irra deebi'ee olkaafama. Kaartaa kaastonni pirojektii walsimsiisuu ykn "
"irra deebi'anii buusuu qabu. Guddinni hojii fi deetaan qorannoo "
"QFieldCloud waliin duraan walsime ni eegama."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:18
msgid "Use with caution, after coordinating with your field mappers."
msgstr ""
"Kaartaa kaastota dirree kee waliin erga qindoofteen booda of eeggannoon "
"fayyadami."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:21
msgid "I understand that task progress in the app will be reset."
msgstr "Guddinni hojii appii keessaa akka haaraa'u nan hubadha."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:26
msgid ""
"This will overwrite any assignment updates made by mappers in the app. "
"Use with caution\n"
"    after coordinating with your field mappers."
msgstr ""
"Kun jijjiirama ramaddii kaartaa kaastonni appii keessatti godhan hunda ni"
" irra barreessa. Kaartaa kaastota dirree kee waliin erga qindoofteen "
"booda of eeggannoon fayyadami."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:27

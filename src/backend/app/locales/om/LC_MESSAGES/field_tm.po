msgid "Resources"
msgstr "Qabeenya"

#: app/templates/landing.html:644
msgid "Data Prep"
msgstr "Qophii dataa"

#: app/templates/landing.html:645
msgid "HOT Export Tool"
msgstr "Meeshaa baafata HOT"


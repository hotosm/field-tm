msgid "Failed to start basemap generation right now. Please try again shortly."
msgstr ""
"Amma uuminsa kaartaa buʼuuraa jalqabuun hin milkoofne. Mee yeroo muraasa "
"keessatti irra deebiʼii yaali."

#: app/htmx/basemap/basemap_fragments.py:153
msgid "Failed to refresh basemap status right now. Please try again shortly."
msgstr ""
"Amma haalata kaartaa buʼuuraa haaromsuun hin milkoofne. Mee yeroo muraasa"
" keessatti irra deebiʼii yaali."

#: app/htmx/basemap/basemap_routes.py:113

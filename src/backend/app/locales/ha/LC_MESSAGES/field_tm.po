#: app/projects/mapping_apps.py:48
msgid "GIS mapping app for Android and iOS, with our simple task plugin."
msgstr ""
"Manhajar zana taswira ta GIS don Android da iOS, tare da sauƙaƙan plugin "
"ɗinmu na ayyuka."

#: app/projects/mapping_apps.py:49
msgid "Drawing and editing geometry, detailed surveys"
msgstr "Zana da gyara siffofi, cikakkun bincike"

#: app/projects/mapping_apps.py:57
msgid "Form-based survey app for Android."
msgstr "Manhajar bincike mai amfani da fom don Android."

#: app/projects/mapping_apps.py:58
msgid "Form-heavy surveys, simple phones"
msgstr "Bincike masu fom da yawa, wayoyi masu sauƙi"

#: app/projects/mapping_apps.py:66
msgid "Fast OpenStreetMap editor for shops, amenities and entrances."
msgstr "Editan OpenStreetMap mai sauri don shaguna, wuraren aiki da ƙofofin shiga."

#: app/projects/mapping_apps.py:67
msgid "Updating existing OSM buildings and points of interest"
msgstr "Sabunta gine-gine da wuraren sha'awa da ke cikin OSM"

#: app/projects/mapping_apps.py:75
msgid "Answer simple quests to complete OpenStreetMap data."
msgstr "Amsa tambayoyi masu sauƙi don cike bayanan OpenStreetMap."

#: app/projects/mapping_apps.py:76
msgid "Quick OSM attribute quests on roads and points of interest"
msgstr "Tambayoyi masu sauri kan halayen OSM a hanyoyi da wuraren sha'awa"

#: app/projects/mapping_apps.py:84
msgid "Offline-first mapping for communities and territories."
msgstr "Zana taswira ba tare da intanet ba don al'ummomi da yankuna."

#: app/projects/mapping_apps.py:85
msgid "Offline, community-led mapping"
msgstr "Zana taswira ba tare da intanet ba, ƙarƙashin jagorancin al'umma"

#: app/projects/mapping_apps.py:93
msgid "Offline maps and navigation, with OSM editing."
msgstr "Taswirori da jagorar hanya ba tare da intanet ba, tare da gyara OSM."

#: app/projects/mapping_apps.py:94
msgid "Navigating to tasks, editing OSM points"
msgstr "Jagora zuwa ayyuka, gyara wuraren OSM"

#: app/projects/mapping_apps.py:102

"          about."
msgstr ""
"Đặt tên rõ ràng và viết tóm tắt ngắn để người lập bản đồ biết dự án nói "
"về gì."

#: app/templates/new_project_custom.html:40
msgid "Project name"
msgstr "Tên dự án"

#: app/templates/new_project_custom.html:45
msgid "e.g. Buildings in West Nairobi"
msgstr "ví dụ: Tòa nhà ở Tây Nairobi"


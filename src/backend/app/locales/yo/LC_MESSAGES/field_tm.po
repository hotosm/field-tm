msgstr "Aṣiṣe airotẹlẹ ṣẹlẹ. Jọwọ gbiyanju lẹẹkansi."

#: app/htmx/project_create/project_create_templates.py:119
msgid "Failed to load template form."
msgstr "Kò ṣee ṣe láti kó fọ́ọ̀mù àpẹrẹ wọlé."

#: app/htmx/project_create/project_create_templates.py:127
msgid "Please select a form or upload a file."
msgstr "Jọwọ yan fọ́ọ̀mù kan tàbí gbe fáìlì kan sókè."

#: app/htmx/project_create/project_create_xlsform_routes.py:128
msgid "Form validated and uploaded successfully! Reloading page..."

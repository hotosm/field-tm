#: app/templates/partials/project_details/fragments/task_sync_confirm.html:12
msgid ""
"The task entities in ODK Central will be replaced and every task status\n"
"      reset to ready. Mapping progress in ODK Collect will be lost. "
"Submissions are kept in ODK\n"
"      Central."
msgstr ""
"A ga-edochi ihe ọrụ dị na ODK Central, a ga-ahazigharịkwa ọnọdụ ọrụ ọ "
"bụla ka ọ bụrụ njikere. Ọganihu maapụ na ODK Collect ga-efu. Ihe ezitere "
"ka ga-adị na ODK Central."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:14
msgid ""
"The task layer of the QField project will be regenerated and\n"
"      re-uploaded to QFieldCloud. Mappers must sync or re-download the "
"project. Task progress and\n"
"      survey data already synced to QFieldCloud are kept."
msgstr ""
"A ga-emepụta ọzọ layer ọrụ nke ọrụ QField wee bulite ya ọzọ na "
"QFieldCloud. Ndị na-ese maapụ ga-ejikọ ma ọ bụ budata ọrụ ahụ ọzọ. A na-"
"edobe ọganihu ọrụ na data nyocha ejikọrọ na QFieldCloud."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:18
msgid "Use with caution, after coordinating with your field mappers."
msgstr "Jiri nlezianya mee ya, mgbe gị na ndị na-ese maapụ n'ọhịa gị kwekọrịtara."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:21
msgid "I understand that task progress in the app will be reset."
msgstr "Aghọtara m na a ga-ahazigharị ọganihu ọrụ na ngwa ahụ."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:26
msgid ""
"This will overwrite any assignment updates made by mappers in the app. "
"Use with caution\n"
"    after coordinating with your field mappers."
msgstr ""
"Nke a ga-edegharị mgbanwe nkenye ọ bụla ndị na-ese maapụ mere na ngwa "
"ahụ. Jiri nlezianya mee ya, mgbe gị na ndị na-ese maapụ n'ọhịa gị "
"kwekọrịtara."

#: app/templates/partials/project_details/fragments/task_sync_confirm.html:27
msgid ""
"Mappers must sync the\n"
"    QField project to get the changes."
msgstr "Ndị na-ese maapụ ga-ejikọ ọrụ QField iji nweta mgbanwe ndị ahụ."


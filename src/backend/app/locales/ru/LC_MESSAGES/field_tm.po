msgstr "Tasking Manager вернул ошибку (HTTP %(status)s)."

#: app/htmx/setup_steps/setup_step_validate_routes.py:81
msgid "Tasking Manager returned an invalid response."
msgstr "Tasking Manager вернул некорректный ответ."

#: app/htmx/setup_steps/setup_step_validate_routes.py:101
msgid "The project area contains invalid geometry. Please fix it and retry."
msgstr ""

#: app/htmx/setup_steps/setup_step_validate_routes.py:118
#, python-format
msgid ""
"Area is %(area_km2)s km², which exceeds the %(area_limit)s km² limit. "
"Please reduce your project area."
msgstr ""
"Площадь составляет %(area_km2)s км², что превышает лимит %(area_limit)s "

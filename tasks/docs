# List available commands
[private]
default:
  just --justfile {{justfile()}} --list docs

# Generate OpenAPI JSON from Litestar app into docs/openapi/openapi.json
[no-cd]
openapi:
  #!/usr/bin/env sh
  set -eu

  # Ensure a .env file is present
  just config generate-dotenv

  # Ensure backend image is built
  just build backend

  cd {{justfile_directory()}}
  mkdir -p docs/openapi

  OSM_CLIENT_ID="x" \
  OSM_CLIENT_SECRET="y" \
  docker compose run --rm --no-deps --entrypoint python backend -c \
    "import json; from app.main import api; print(json.dumps(api.openapi_schema.to_schema(), separators=(',', ':')))" \
    > docs/openapi/openapi.json
  docker compose down
  echo "Generated docs/openapi/openapi.json"

# Build MkDocs static site in a publishable directory
[no-cd]
build output_dir="site":
  #!/usr/bin/env sh
  set -eu

  cd {{justfile_directory()}}
  just docs openapi

  # Create the output dir on the host, so it is not root-owned by the
  # container (mkdocs only empties it), and coverage can be copied in below
  rm -rf "{{ output_dir }}"
  mkdir -p "{{ output_dir }}"

  docker run --rm \
    -v "$PWD:/work" \
    -w /work \
    --entrypoint=/bin/sh \
    ghcr.io/hotosm/gh-workflows/mkdocs:main \
      -c 'git config --global --add safe.directory /work \
        && mkdocs build --config-file mkdocs.yml --site-dir "$1"' \
      sh "{{ output_dir }}"

  # Include the coverage report (from `just test backend-coverage`), if present
  if [ -d coverage/htmlcov ]; then
    cp -R coverage/htmlcov "{{ output_dir }}/coverage"
  fi

  # Include the standalone planner at /planner/ (same gh-pages site)
  if [ -f src/planner/package.json ]; then
    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp \
      -v "$PWD/src/planner:/app" -w /app node:24-alpine \
      sh -c 'npx -y pnpm@10 install --frozen-lockfile && npx -y pnpm@10 build'
    cp -R src/planner/dist "{{ output_dir }}/planner"
  fi

# Run docs website locally in a container
[no-cd]
serve:
  #!/usr/bin/env sh
  set -eu

  cd {{justfile_directory()}}
  just docs openapi

  docker run --rm -it \
    -p "8000:8000" \
    -v "$PWD:/work" \
    -w /work \
    --entrypoint=/bin/sh \
    ghcr.io/hotosm/gh-workflows/mkdocs:main \
      -c "\
        git config --global --add safe.directory /work \
        && mkdocs serve --config-file mkdocs.yml --dev-addr 0.0.0.0:8000 \
      "

# Build publishable docs bundle
[no-cd]
publish output_dir="site":
  #!/usr/bin/env sh
  set -eu

  cd {{justfile_directory()}}
  just test backend-coverage
  just docs build "{{ output_dir }}"

  docker run --rm \
    -v "$PWD:/work" \
    -w /work \
    --entrypoint=/bin/sh \
    ghcr.io/hotosm/gh-workflows/mkdocs:main \
      -c 'git config --global --add safe.directory /work \
        && ghp-import --no-jekyll --push --force "$1"' \
      sh "{{ output_dir }}"

# List available commands
[private]
default:
  just --justfile {{justfile()}} --list test

# Test backend
[no-cd]
all: backend

# Test all backend code (including packages)
[no-cd]
backend:
  just stop all
  docker compose -f compose.test.yaml down -v --remove-orphans
  just build backend
  # Start all service and ensure API has finish init process
  docker compose -f compose.test.yaml up --detach
  docker compose -f compose.test.yaml run --rm backend pytest
  docker compose -f compose.test.yaml down -v --remove-orphans

# Cleanup orphan backend tests
[no-cd]
backend-cleanup:
  docker compose -f compose.test.yaml down -v --remove-orphans


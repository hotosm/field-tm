# Start tunnel + create a test ODK buildings project for mobile testing with ODK Collect
[no-cd]
odk-collect:
  #!/usr/bin/env sh
  set -e

  cd {{justfile_directory()}}

  # Start all services + cloudflare quick tunnels
  just start tunnel

  # Get the ODK Central tunnel URL
  odk_tunnel_url=$(just start _get-tunnel-url 'central')
  if [ -z "$odk_tunnel_url" ]; then
    echo "ERROR: Could not determine ODK Central tunnel URL."
    exit 1
  fi
  echo "ODK Central tunnel: ${odk_tunnel_url}"

  # Extract hostname for FTM_CENTRAL_DOMAIN (must be passed to every subsequent
  # `docker compose up` call so Compose doesn't see a config drift on central and
  # silently recreate it with the default odk.field.localhost domain).
  central_domain="$(echo "${odk_tunnel_url}" | sed -E 's|^https://([^/:]+).*$|\1|')"

  # Ensure Central DOMAIN always matches the current public tunnel host.
  just start _restart-central-with-tunnel-domain "${odk_tunnel_url}"

  # Restart backend with tunnel URL set. FTM_CENTRAL_DOMAIN is passed so Compose
  # evaluates central's config identically to the running container and skips it.
  FTM_CENTRAL_DOMAIN="${central_domain}" \
  ODK_CENTRAL_PUBLIC_URL="${odk_tunnel_url}" \
  docker compose \
    -f compose.yaml \
    -f contrib/tunnel/compose.yaml \
    up -d --wait --force-recreate backend

  # Create a test buildings project using the service layer inside the container.
  # The script is passed via stdin to avoid justfile heredoc indentation issues.
  echo "Creating ODK test project..."
  docker compose exec -T \
    -e ODK_CENTRAL_TUNNEL_URL="${odk_tunnel_url}" \
    backend python3 - < tasks/scripts/create_test_project.py

# Backward-compatible alias for ODK Central mobile testing workflow
[no-cd]
odk-central:
  just test odk-collect

# Start services + create a test QField buildings project for mobile testing with QField
[no-cd]
qfield:
  #!/usr/bin/env sh
  set -e

  cd {{justfile_directory()}}

  # Start all services (including the local QFieldCloud instance) and wait until
  # all containers report healthy before proceeding.
  docker compose up -d --wait

  # Create a test QField buildings project using the service layer inside the container.
  echo "Creating QField test project..."
  docker compose exec -T backend python3 - < tasks/scripts/create_qfield_test_project.py

# Run load test on backend API (e.g. just test load projects/62/minimal)
[no-cd]
load url_path:
  docker compose \
    -f contrib/load_testing/compose.yaml \
    run --rm k6 run /load-test.js -e url_path={{ url_path }}

# Check coverage for backend tests and workspace packages
[no-cd]
backend-coverage:
  #!/usr/bin/env sh
  set -eu

  cd {{justfile_directory()}}
  export TAG_OVERRIDE=ci-dev
  export TARGET_OVERRIDE=debug
  just build backend

  cleanup() {
    docker rm --force backend-coverage-run >/dev/null 2>&1 || true
    docker compose -f compose.test.yaml down -v --remove-orphans
  }
  trap cleanup EXIT
  trap 'exit 1' HUP INT TERM

  # Remove old artifacts so failed runs cannot publish stale results.
  rm -rf coverage
  cleanup
  docker compose -f compose.test.yaml up --detach
  docker compose -f compose.test.yaml run \
    --name backend-coverage-run \
    --entrypoint sh \
    backend -ec \
    "coverage run --source=app,osm_fieldwork,area_splitter -m pytest \
      && coverage report && coverage html \
      && coverage json"

  mkdir -p coverage
  docker cp backend-coverage-run:/opt/htmlcov coverage/htmlcov
  docker cp backend-coverage-run:/opt/coverage.json coverage/coverage.json
  # Badge is published with the report, at /coverage/badge.json
  python3 tasks/scripts/shields_badge.py \
    coverage/coverage.json coverage/htmlcov/badge.json
